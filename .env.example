# Repo-wide examples (agent-delegations)
RPC_URL=https://sepolia.example
SEPOLIA_RPC_URL=https://sepolia.example
ENS_NAME=delegated-agent.eth
HOOK_KEY=eth.ecs.agent-delegations.delegates
HOOK_VALUE=hook("text(0x<namehash>,'eth.ecs.agent-delegations:0')",0x<resolver>)
ECS_GATEWAY_URL=https://ccip-read-offchain-resolver.vercel.app/{sender}/{data}.json

# Offchain resolver (agent-delegations/offchain-resolver)
BASE_SEPOLIA_AGENT_DELEGATIONS_RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000
PORT=3000

# Deploy scripts
DEPLOY_PRIVATE_KEY=0x...
DEPLOYER_PRIVATE_KEY=0x...
ASSOCIATIONS_STORE_ADDRESS=0x0000000000000000000000000000000000000000
AGENT_DELEGATIONS_RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000
TEXT_RECORD_PREFIX=eth.ecs.agent-delegations:

# RegisterAgentDelegationsExample.s.sol
DELEGATOR_PRIVATE_KEY=0x...
AGENT1_PRIVATE_KEY=0x...
AGENT2_PRIVATE_KEY=0x...
AGENT1_METADATA_JSON={"association":"Delegated Agent","name":"Agent One","description":"Demo agent 1","endpoints":[]}
AGENT2_METADATA_JSON={"association":"Delegated Agent","name":"Agent Two","description":"Demo agent 2","endpoints":[]}
